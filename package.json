{
  "name": "vasmc-workspace",
  "version": "0.7.0",
  "private": true,
  "description": "Vibe Assembly Compiler monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "clean": "rm -rf packages/*/dist dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release:check": "npm test && npm run clean && npm run build && node packages/cli/dist/index.js build && git diff --check && npm --cache /private/tmp/vasmc-npm-cache pack --workspaces --dry-run",
    "release:github": "node scripts/release-github.js",
    "release:publish": "npm run release:check && changeset publish",
    "release:version": "changeset version",
    "self-eval:hard-checks": "node scripts/run-self-eval-hard-checks.js",
    "test": "tsc --noEmit && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@ai-sdk/openai": "3.0.36",
    "@changesets/cli": "2.31.0",
    "@types/mdast": "4.0.4",
    "@types/node": "25.3.1",
    "ai": "6.0.104",
    "commander": "14.0.3",
    "dotenv": "17.3.1",
    "franc-min": "6.2.0",
    "glob": "13.0.6",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-to-markdown": "2.1.2",
    "minimatch": "10.2.4",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unist-util-visit-parents": "6.0.2",
    "yaml": "2.8.2"
  }
}

{
  "name": "@vasm/cli",
  "version": "0.5.1",
  "description": "Vibe Assembly Compiler — a deterministic Markdown prompt compiler and package manager for LLM contexts.",
  "main": "dist/index.js",
  "bin": {
    "vasmc": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsc --noEmit && node --test tests/*.test.js",
    "login": "npm login --registry=https://registry.npmjs.org",
    "publish": "npm publish --registry=https://registry.npmjs.org --access public"
  },
  "keywords": [
    "markdown",
    "compiler",
    "package-manager",
    "llm",
    "prompt-engineering"
  ],
  "author": "glenzli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glenzli/vasmc.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.3.1",
    "@types/unist": "^3.0.3",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "mdast-util-to-markdown": "^2.1.2",
    "minimatch": "^10.2.4",
    "remark-parse": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.36",
    "ai": "^6.0.104",
    "dotenv": "^17.3.1",
    "franc-min": "^6.2.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "mdast-util-directive": "^3.1.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-stringify": "^11.0.0"
  }
}
